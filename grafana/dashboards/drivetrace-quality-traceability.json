      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT q.\"RecordedAt\", pu.\"UnitCode\", COALESCE(pls.\"Name\", '-') AS section, COALESCE(cp.\"Name\", '-') AS checkpoint, q.\"Result\", COALESCE(q.\"Notes\", '-') AS notes FROM \"QualityResults\" q LEFT JOIN \"ProductUnits\" pu ON pu.\"Id\" = q.\"ProductUnitId\" LEFT JOIN \"Checkpoints\" cp ON cp.\"Id\" = q.\"CheckpointId\" LEFT JOIN \"ProductionLineSections\" pls ON pls.\"Id\" = cp.\"SectionId\" ORDER BY q.\"RecordedAt\" DESC LIMIT 30;"
        }
      ]
    },
    {
      "id": 8,
