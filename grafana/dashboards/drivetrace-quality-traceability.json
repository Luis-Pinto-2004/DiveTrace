    {
      "id": 7,
      "type": "table",
      "title": "Recent quality events table",
      "description": "Most recent 20 quality results with notes.",
      "datasource": {
        "type": "postgres",
        "uid": "drivetrace-timescaledb"
      },
      "gridPos": {
        "h": 10,
