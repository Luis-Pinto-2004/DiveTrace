      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT entity_type, total FROM (SELECT 'Support' AS entity_type, COUNT(*) AS total FROM \"Supports\" UNION ALL SELECT 'ProductUnit' AS entity_type, COUNT(*) AS total FROM \"ProductUnits\" UNION ALL SELECT 'Rack' AS entity_type, COUNT(*) AS total FROM \"Racks\" UNION ALL SELECT 'ProductionLineSection' AS entity_type, COUNT(*) AS total FROM \"ProductionLineSections\" UNION ALL SELECT 'Checkpoint' AS entity_type, COUNT(*) AS total FROM \"Checkpoints\") source ORDER BY total DESC, entity_type;"
        }
      ]
    },
