          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE COALESCE(\"Status\", 'Desconhecido') WHEN 'Active' THEN 'Em produção' WHEN 'In Progress' THEN 'Em progresso' WHEN 'Completed' THEN 'Concluída' WHEN 'Blocked' THEN 'Bloqueada' WHEN 'Rework' THEN 'Em retrabalho' WHEN 'Scrap' THEN 'Sucata' WHEN 'Stored' THEN 'Armazenado' WHEN 'Loaded' THEN 'Carregado' WHEN 'Available' THEN 'Disponível' WHEN 'Pending' THEN 'Pendente' WHEN 'Planned' THEN 'Planeada' WHEN 'Cancelled' THEN 'Cancelada' WHEN 'Open' THEN 'Aberto' WHEN 'Closed' THEN 'Fechado' ELSE COALESCE(\"Status\", 'Desconhecido') END AS estado, COUNT(*) AS total FROM \"ProductUnits\" GROUP BY \"Status\" ORDER BY estado;"
        }
