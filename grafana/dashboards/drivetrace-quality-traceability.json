      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(pls.\"Name\", 'Unknown section') AS section, COUNT(q.\"Id\") FILTER (WHERE COALESCE(q.\"Result\", '') = 'FAIL') AS fail_results, COUNT(q.\"Id\") AS total_results FROM \"QualityResults\" q LEFT JOIN \"Checkpoints\" cp ON cp.\"Id\" = q.\"CheckpointId\" LEFT JOIN \"ProductionLineSections\" pls ON pls.\"Id\" = cp.\"SectionId\" GROUP BY COALESCE(pls.\"Name\", 'Unknown section') ORDER BY fail_results DESC, total_results DESC;"
        }
      ]
    }
