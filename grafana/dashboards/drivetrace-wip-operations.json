          "fields": "",
          "countRows": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DATE_TRUNC('day', pu.\"CreatedAt\")::date AS day, COUNT(*) AS created_units, COUNT(*) FILTER (WHERE pu.\"CompletedAt\" IS NOT NULL OR COALESCE(pu.\"Status\", '') IN ('Completed', 'Closed')) AS completed_units FROM \"ProductUnits\" pu GROUP BY DATE_TRUNC('day', pu.\"CreatedAt\")::date ORDER BY day DESC LIMIT 30;"
        }
      ]
    }
