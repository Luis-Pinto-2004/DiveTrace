# DriveTrace Core — exemplo de variáveis de ambiente
# Copiar para .env e ajustar. NUNCA versionar segredos reais.
# A autenticação atual é demo/local (ver docs/NOTAS_TECNICAS.md).

# --- Base de dados (PostgreSQL/TimescaleDB) ---
POSTGRES_DB=drivetrace
POSTGRES_USER=drivetrace
POSTGRES_PASSWORD=change-me-in-production

# Cadeia de ligação consumida pela API (.NET).
# Em docker-compose é injetada como ConnectionStrings__DefaultConnection.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=drivetrace;Username=drivetrace;Password=change-me-in-production

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
# Origens permitidas para CORS (separadas por vírgula via configuração).
Cors__AllowedOrigins__0=http://localhost:8088
Cors__AllowedOrigins__1=http://localhost:5173

# Semear dados demo no arranque (true em ambiente de demonstração).
Database__SeedDemoData=true
Database__EnsureCreated=true

# --- FIWARE ---
Fiware__OrionLdBaseUrl=http://orion:1026/ngsi-ld/v1
Fiware__ContextUrl=https://uri.drivolution.local/context.jsonld

# --- Frontend (build) ---
VITE_API_URL=http://localhost:5181/api
