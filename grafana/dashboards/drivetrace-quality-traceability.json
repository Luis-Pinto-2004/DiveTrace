      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CONCAT(rm.\"Name\", ' / ', lrm.\"LotNumber\") AS material_lot, SUM(umlu.\"Quantity\") AS total FROM \"UnitMaterialLotUsages\" umlu LEFT JOIN \"LotRawMaterials\" lrm ON lrm.\"Id\" = umlu.\"LotId\" LEFT JOIN \"RawMaterials\" rm ON rm.\"Id\" = lrm.\"RawMaterialId\" GROUP BY CONCAT(rm.\"Name\", ' / ', lrm.\"LotNumber\") ORDER BY material_lot;"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Unit genealogy/material lot usage table",
      "description": "Traceability table linking units to consumed material lots.",
      "datasource": {
        "type": "postgres",
        "uid": "drivetrace-timescaledb"
