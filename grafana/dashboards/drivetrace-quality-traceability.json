          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pu.\"UnitCode\", lrm.\"LotNumber\", rm.\"Name\" AS material, umlu.\"Quantity\", umlu.\"AssociationType\" FROM \"UnitMaterialLotUsages\" umlu LEFT JOIN \"ProductUnits\" pu ON pu.\"Id\" = umlu.\"ProductUnitId\" LEFT JOIN \"LotRawMaterials\" lrm ON lrm.\"Id\" = umlu.\"LotId\" LEFT JOIN \"RawMaterials\" rm ON rm.\"Id\" = lrm.\"RawMaterialId\" ORDER BY pu.\"UnitCode\", lrm.\"LotNumber\";"
        }
