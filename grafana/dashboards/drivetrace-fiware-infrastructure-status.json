    {
      "id": 5,
      "type": "table",
      "title": "Context entity candidates by type",
      "description": "Candidate entity totals by type for FIWARE publish operations.",
      "datasource": {
        "type": "postgres",
        "uid": "drivetrace-timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
