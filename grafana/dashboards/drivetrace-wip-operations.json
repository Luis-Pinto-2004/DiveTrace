      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN COALESCE(\"Status\", '') = 'Available' THEN 'Available' WHEN \"Status\" = 'Loaded' THEN 'Loaded' WHEN \"Status\" = 'Blocked' THEN 'Blocked' WHEN \"Status\" = 'Rework' THEN 'Rework' ELSE 'Other' END AS category, COUNT(*) AS total FROM \"Supports\" GROUP BY CASE WHEN COALESCE(\"Status\", '') = 'Available' THEN 'Available' WHEN \"Status\" = 'Loaded' THEN 'Loaded' WHEN \"Status\" = 'Blocked' THEN 'Blocked' WHEN \"Status\" = 'Rework' THEN 'Rework' ELSE 'Other' END ORDER BY category;"
        }
      ]
