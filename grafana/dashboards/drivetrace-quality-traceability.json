      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pu.\"UnitCode\" AS \"ProductUnit\", COALESCE(s.\"SupportCode\", '-') AS \"CurrentSupport\", COALESCE(pls.\"Name\", '-') AS \"CurrentSection\", COALESCE(pu.\"QualityStatus\", 'Pending') AS \"QualityStatus\", COALESCE(pu.\"Status\", 'Unknown') AS \"Status\" FROM \"ProductUnits\" pu LEFT JOIN \"Supports\" s ON s.\"Id\" = pu.\"CurrentSupportId\" LEFT JOIN \"ProductionLineSections\" pls ON pls.\"Id\" = pu.\"CurrentSectionId\" ORDER BY pu.\"UnitCode\";"
        }
      ]
    },
