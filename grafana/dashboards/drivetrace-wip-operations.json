      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(pls.\"Name\", 'Unknown section') AS section, COUNT(pu.\"Id\") FILTER (WHERE COALESCE(pu.\"Status\", '') IN ('Blocked', 'Rework')) AS blocked_or_rework_units, COUNT(pu.\"Id\") AS total_units FROM \"ProductionLineSections\" pls LEFT JOIN \"ProductUnits\" pu ON pu.\"CurrentSectionId\" = pls.\"Id\" GROUP BY COALESCE(pls.\"Name\", 'Unknown section'), pls.\"Id\" ORDER BY blocked_or_rework_units DESC, total_units DESC, pls.\"Id\";"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Throughput proxy by day",
      "description": "Created vs completed product units by day.",
      "datasource": {
        "type": "postgres",
        "uid": "drivetrace-timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
