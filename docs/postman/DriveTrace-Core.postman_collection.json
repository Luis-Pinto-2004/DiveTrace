{
  "info": {
    "name": "DriveTrace Core API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Resumo da dashboard",
      "request": {
        "method": "GET",
        "url": "http://localhost:5181/api/dashboard/summary"
      }
    },
    {
      "name": "Unidades de produto",
      "request": {
        "method": "GET",
        "url": "http://localhost:5181/api/product-units"
      }
    },
    {
      "name": "Suportes",
      "request": {
        "method": "GET",
        "url": "http://localhost:5181/api/supports"
      }
    },
    {
      "name": "Rastreabilidade da UP-PORTA-001 por id",
      "request": {
        "method": "GET",
        "url": "http://localhost:5181/api/traceability/product-units/1"
      }
    },
    {
      "name": "Executar reprodução",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"scenario\":\"door-line-demo\"}" },
        "url": "http://localhost:5181/api/events/playback"
      }
    },
    {
      "name": "Movimento manual de suporte",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"eventType\": \"MoveSupport\",\n  \"supportCode\": \"SUP-005\",\n  \"sectionCode\": \"SEC-SOLD\",\n  \"productUnitCode\": \"UP-PORTA-005\",\n  \"notes\": \"Evento manual controlado a partir do Postman.\"\n}" },
        "url": "http://localhost:5181/api/events/manual"
      }
    },
    {
      "name": "Contexto FIWARE atual",
      "request": {
        "method": "GET",
        "url": "http://localhost:5181/api/fiware/context"
      }
    }
  ]
}
