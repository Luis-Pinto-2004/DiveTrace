      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pu.\"UnitCode\", COALESCE(s.\"SupportCode\", '-') AS support_code, COALESCE(pls.\"Name\", '-') AS current_section, COALESCE(pu.\"QualityStatus\", 'Pending') AS quality_status, COALESCE(pu.\"Status\", 'Unknown') AS unit_status FROM \"ProductUnits\" pu LEFT JOIN \"Supports\" s ON s.\"Id\" = pu.\"CurrentSupportId\" LEFT JOIN \"ProductionLineSections\" pls ON pls.\"Id\" = pu.\"CurrentSectionId\" ORDER BY pu.\"UnitCode\";"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Supports currently loaded/blocked/rework/available",
      "description": "Operational support status snapshot.",
      "datasource": {
        "type": "postgres",
        "uid": "drivetrace-timescaledb"
      },
      "gridPos": {
        "h": 8,
