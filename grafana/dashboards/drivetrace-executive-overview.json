      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "drivetrace-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT nc.\"CreatedAt\" AS \"Criada em\", pu.\"UnitCode\" AS \"Unidade\", CASE COALESCE(nc.\"Severity\", 'Unknown') WHEN 'Minor' THEN 'Menor' WHEN 'Medium' THEN 'Média' WHEN 'Major' THEN 'Maior' WHEN 'Critical' THEN 'Crítica' ELSE COALESCE(nc.\"Severity\", 'Desconhecida') END AS \"Severidade\", CASE COALESCE(nc.\"Status\", 'Unknown') WHEN 'Open' THEN 'Aberto' WHEN 'Blocked' THEN 'Bloqueado' WHEN 'Rework' THEN 'Em retrabalho' WHEN 'Closed' THEN 'Fechado' WHEN 'In Progress' THEN 'Em progresso' ELSE COALESCE(nc.\"Status\", 'Desconhecido') END AS \"Estado\", COALESCE(nc.\"Description\", '-') AS \"Descrição\" FROM \"Nonconformities\" nc LEFT JOIN \"ProductUnits\" pu ON pu.\"Id\" = nc.\"ProductUnitId\" ORDER BY nc.\"CreatedAt\" DESC LIMIT 30;"
        }
      ]
