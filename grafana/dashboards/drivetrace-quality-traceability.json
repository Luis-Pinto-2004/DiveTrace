    {
      "id": 10,
      "type": "table",
      "title": "Traceability table: unit-support-section-quality",
      "description": "Current traceability state for product units.",
      "datasource": {
        "type": "postgres",
        "uid": "drivetrace-timescaledb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
